# Secretos y configuración por ambiente. Plantilla: copiar a .env y completar (el .env no va a git).
# Spring lo carga con spring.config.import (ver application.properties).
# En Render se sube como Secret File con nombre .env (queda en /etc/secrets/.env).
# En desarrollo no hace falta: el perfil dev trae la BD local y su propio secreto.

# BASE DE DATOS (Supabase: Session pooler, IPv4)
BD_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
BD_USUARIO=
BD_CONTRASENA=

# JWT: cadena aleatoria de al menos 32 caracteres (openssl rand -base64 48)
APP_SEGURIDAD_JWT_SECRETO=

# Orígenes del front, separados por coma (ej. https://baterias-front.onrender.com)
APP_CORS_ORIGENES=

# Primer administrador (solo se usa si la tabla usuario está vacía; luego cambiar la contraseña)
APP_SEGURIDAD_ADMIN_CORREO=
APP_SEGURIDAD_ADMIN_CONTRASENA=
